# cloudbench SECRETS ONLY. Copy to .env (gitignored) and fill in.
# Everything NON-secret (regions, image ids, instance types, platform ids)
# lives in configs/providers.conf — keep this file limited to credentials.

# Sesterce API key (the only real secret cloudbench needs).
SESTERCE_API_KEY=

# Nebius and Modal do NOT use a key here:
#   Nebius -> `nebius init`        (creds stored by the CLI)
#   Modal  -> `modal token new`    (creds stored in ~/.modal.toml)
